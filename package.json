{
  "name": "lumina",
  "version": "1.0.0",
  "private": true,
  "description": "A local, encrypted 2FA authenticator for Windows with a liquid-glass interface.",
  "main": "out/main/index.js",
  "author": "Lumina contributors",
  "license": "MIT",
  "homepage": "https://github.com/neuroxil/Lumina",
  "bugs": {
    "url": "https://github.com/neuroxil/Lumina/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuroxil/Lumina.git"
  },
  "keywords": [
    "2fa",
    "totp",
    "hotp",
    "authenticator",
    "electron",
    "windows",
    "otp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder --win",
    "package:portable": "npm run build && electron-builder --win portable",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "framer-motion": "^11.15.0",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-icons": "^16.32.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^8.3.3",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "app.lumina.authenticator",
    "productName": "Lumina",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "build/icon.png"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": null,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumina",
      "uninstallDisplayName": "Lumina Authenticator",
      "artifactName": "${productName}-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-win-x64-portable.${ext}",
      "requestExecutionLevel": "user"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
